# Copy to .env and fill in. Never commit .env.

# --- OpsDesk
OPSDESK_APP_ENV=
OPSDESK_VAR_DIR=
OPSDESK_LOG_LEVEL=

# --- LLM gateway (OpenAI-compatible), used from M03
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- LangSmith (optional), used from M07
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# --- Langfuse (optional), used from M16
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
