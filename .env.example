# Copy to .env and fill in. Never commit .env.

# --- OpsDesk
OPSDESK_APP_ENV=
OPSDESK_VAR_DIR=
OPSDESK_LOG_LEVEL=

# --- API server (M04). Host/port default to 127.0.0.1:8000.
# Session secret: >= 32 chars, required in prod; unset in dev = random per process.
OPSDESK_API_HOST=
OPSDESK_API_PORT=
OPSDESK_SESSION_SECRET=
OPSDESK_SESSION_TTL_MINUTES=

# --- LLM gateway (OpenAI-compatible), used from M03
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model name per role: whatever the gateway exposes. Agents ask for a role, never a name.
OPSDESK_MODEL_ROUTER=
OPSDESK_MODEL_SPECIALIST=
OPSDESK_MODEL_SYNTHESIZER=
OPSDESK_MODEL_JUDGE=
# Optional. Temperature: unset = not sent (model default; reasoning models need this). Timeout default 30 s.
OPSDESK_LLM_TEMPERATURE=
OPSDESK_LLM_TIMEOUT_S=

# --- LangSmith (optional), used from M07
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# --- Langfuse (optional), used from M16
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
